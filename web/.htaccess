# Futoshiki for Adults — served from public_html/play/futoshiki/

# ── MIME types ──────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType text/javascript .js .mjs
  AddType application/json .json
  AddType font/otf .otf
  AddType font/ttf .ttf
  AddType application/octet-stream .bin .frag .symbols
  AddType image/x-icon .ico
  AddType application/manifest+json .webmanifest
</IfModule>

# ── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json application/wasm font/otf font/ttf image/svg+xml
</IfModule>

# ── Caching ─────────────────────────────────────────────────────────────────
# Flutter does not put content hashes in main.dart.js, flutter_bootstrap.js
# or assets/*, so never cache them long-term or as immutable: "no-cache"
# lets the browser keep a copy but revalidate it (cheap 304) on every load.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|wasm|json|bin|otf|ttf|frag|png|ico|symbols)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>
